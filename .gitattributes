# Set default behavior to force LF on checkout
* text=auto eol=lf

# Explicit text files requiring LF
*.sh text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.toml text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.wasm binary
*.jpg binary
*.jpeg binary
*.ico binary

